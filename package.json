{
  "name": "dsh-shared-workspace-memory",
  "version": "0.2.2",
  "description": "Shared memory across every DSH workspace: one knowledge base whose index is injected into the system prompt, searched by the `kb` command or the kb_* tools, and appended at the end of a task. 跨 workspace 共享记忆/知识库：索引自动注入系统提示，kb 命令与工具检索，收尾沉淀。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "shared-memory",
    "workspace-memory",
    "knowledge",
    "kb",
    "知识库",
    "记忆"
  ],
  "license": "MIT",
  "author": "tanxiaolong",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanxiaolong/dsh-shared-workspace-memory.git"
  },
  "homepage": "https://github.com/tanxiaolong/dsh-shared-workspace-memory#readme",
  "bugs": {
    "url": "https://github.com/tanxiaolong/dsh-shared-workspace-memory/issues"
  },
  "engines": {
    "dsh": ">=0.14.0"
  }
}
